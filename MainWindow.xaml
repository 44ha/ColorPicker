<Window x:Class="ColorPicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ColorPicker.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Chroma — Color Picker"
        Width="1080" Height="760"
        MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True">

    <!--
        Custom window chrome: we draw our own caption so it stays inside the
        two-colour (white + blue) palette instead of using the system title bar.
        The top edge of the window is kept rectangular (no corner rounding) so
        the caption buttons settle on a square hit-test area and the rounded
        shadow around the rest of the window never shadows the caption itself.
        Caption buttons are styled in App.xaml.

        CaptionHeight MUST be 0. A non-zero caption height makes Windows answer
        WM_NCHITTEST with HTCAPTION for that whole strip, i.e. it is non-client
        drag area: the minimize / maximize / close buttons inside it never
        receive a mouse message at all (verified with WM_NCHITTEST — every point
        of the old 52px band returned HTCAPTION while the body returned
        HTCLIENT, which is why those buttons looked dead). Dragging is done by
        TitleBar_MouseLeftButtonDown instead, in client space where WPF hit-tests
        our own buttons. UseAeroCaptionButtons is off for the same reason: we
        draw and own the three buttons.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="10"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- The rounded Border is clipped so only the area below the caption and
         the two bottom corners are rounded; the top is a rectangle. -->
    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            SnapsToDevicePixels="True">
        <Border.Clip>
            <GeometryGroup>
                <!-- top rectangle (includes the caption) -->
                <RectangleGeometry Rect="0,0,100000,52"/>
                <!-- rounded region below -->
                <RectangleGeometry Rect="0,52,100000,100000" RadiusX="10" RadiusY="10"/>
            </GeometryGroup>
        </Border.Clip>
        <DockPanel>

            <!-- ================= Title bar ================= -->
            <Grid DockPanel.Dock="Top" Height="52" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  SnapsToDevicePixels="True"
                  Margin="-1,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App mark + name -->
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource AccentBrush}">
                        <Ellipse Width="11" Height="11" Fill="#FFFFFFFF"/>
                    </Border>
                    <TextBlock Text="Chroma" FontSize="14.5" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="color picker" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="9,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Hotkey badge + caption buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource HotkeyChipStyle}" Margin="0,0,14,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding HotkeyDisplay}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource CaptionButtonStyle}"
                            Content="&#xE921;"
                            ToolTip="Minimize"
                            Click="MinimizeButton_Click"/>
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            Content="&#xE922;"
                            ToolTip="Maximize"
                            Click="MaximizeButton_Click"/>
                    <Button Style="{StaticResource CaptionCloseButtonStyle}"
                            Content="&#xE8BB;"
                            ToolTip="Close"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- ================= Content ================= -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="36,24,36,36"
                          Margin="0,0,0,8">
                <StackPanel MaxWidth="1040" HorizontalAlignment="Center">

                    <!-- Hero: title + primary actions (buttons on their own row
                         below the text so they can never overlap the copy) -->
                    <StackPanel Margin="0,4,0,18">
                        <TextBlock Text="GLOBAL COLOR PICKER"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Pick any pixel. Get every format."
                                   FontSize="27" FontWeight="SemiBold"
                                   Margin="0,7,0,0"/>
                        <TextBlock FontSize="13.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="640"
                                   Margin="0,9,0,0">
                            <Run Text="Press "/><Run Text="{Binding HotkeyDisplay, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><Run Text=" anywhere on screen — even with this window minimized — then left-click to copy the color under your cursor."/>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Content="Settings"
                                    Command="{Binding ToggleSettingsCommand}"/>
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Pick a color"
                                    Padding="18,10"
                                    Margin="10,0,0,0"
                                    Command="{Binding PickColorCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Status line -->
                    <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Current color card -->
                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasCurrentItem, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="92" Height="92" CornerRadius="20"
                                    BorderBrush="#591D4ED8" BorderThickness="1"
                                    Background="{Binding CurrentBrush}"/>

                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="MOST RECENT"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CurrentItem.Color.Hex}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="23" FontWeight="SemiBold"
                                           Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="RGB  "/><Run Text="{Binding CurrentItem.Color.Rgb, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="18,0,0,0">
                                        <Run Text="HSL  "/><Run Text="{Binding CurrentItem.Color.Hsl, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Content="Copy HEX"
                                    VerticalAlignment="Center"
                                    Command="{Binding CopyCurrentHexCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Settings card -->
                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,0,16"
                            Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="customize the global hotkey"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="10,2,0,0"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Content="Done"
                                        Command="{Binding ToggleSettingsCommand}"/>
                            </Grid>

                            <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,14" BorderBrush="{StaticResource BorderSubtleBrush}"/>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Hotkey" FontSize="13" VerticalAlignment="Center" Width="96"/>

                                <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Content="Ctrl"  IsChecked="{Binding UseControl}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Content="Shift" IsChecked="{Binding UseShift}"   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Content="Alt"   IsChecked="{Binding UseAlt}"     VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <CheckBox Style="{StaticResource DarkCheckBoxStyle}" Content="Win"   IsChecked="{Binding UseWin}"     VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <TextBlock Text="+" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,8,0"/>

                                <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                          Width="86"
                                          ItemsSource="{Binding HotkeyKeyOptions}"
                                          SelectedItem="{Binding SelectedKey}"/>

                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Apply"
                                        Margin="12,0,0,0"
                                        Command="{Binding ApplyHotkeyCommand}"/>
                            </StackPanel>

                            <TextBlock Text="The hotkey works system-wide, even when Chroma is minimized. At least one modifier is required so plain letter keys are never swallowed."
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- History header -->
                    <Grid Margin="0,6,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="History" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource HotkeyChipStyle}" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HistoryCount}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                     Width="160"
                                     VerticalAlignment="Center"
                                     Text="{Binding HexInput, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Content="Add"
                                    Margin="8,0,0,0"
                                    Command="{Binding AddFromHexCommand}"/>
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Content="Clear all"
                                    Margin="8,0,0,0"
                                    Command="{Binding ClearHistoryCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Empty state -->
                    <Border Style="{StaticResource CardStyle}"
                            Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" Margin="0,18">
                            <Ellipse Width="34" Height="34" Fill="{StaticResource AccentDimBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="No colors picked yet"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0">
                                <Run Text="Press "/><Run Text="{Binding HotkeyDisplay, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" anywhere and left-click to capture a color."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ================= History cards ================= -->
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 1: swatch + hex + actions -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="72" Height="72" CornerRadius="16"
                                                    BorderBrush="#591D4ED8" BorderThickness="1"
                                                    Background="{Binding SwatchBrush}"/>

                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Color.Hex}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="18" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Meta}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ToggleButton Style="{StaticResource CardToggleStyle}"
                                                              IsChecked="{Binding IsExpanded}"
                                                              ToolTip="Show / hide all formats"/>
                                                <Button Style="{StaticResource IconButtonStyle}"
                                                        Margin="6,0,0,0"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        Content="&#xE74D;"
                                                        ToolTip="Remove from history"
                                                        Command="{Binding DeleteCommand}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Row 2: one line per format, each with its own Copy button -->
                                        <ItemsControl Grid.Row="1"
                                                      ItemsSource="{Binding Formats}"
                                                      Margin="0,14,0,0"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="86"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center"/>

                                                        <Border Grid.Column="1"
                                                                Background="{StaticResource RowBgBrush}"
                                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="11,7"
                                                                Margin="8,0,8,0">
                                                            <!-- Read-only TextBox instead of TextBlock so the value can be
                                                                 selected with the mouse in addition to the Copy button. -->
                                                            <TextBox Text="{Binding Value, Mode=OneWay}"
                                                                     IsReadOnly="True"
                                                                     IsReadOnlyCaretVisible="False"
                                                                     Background="Transparent"
                                                                     BorderThickness="0"
                                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                                     CaretBrush="{StaticResource AccentBrush}"
                                                                     SelectionBrush="{StaticResource AccentBrush}"
                                                                     FontFamily="{StaticResource MonoFont}"
                                                                     FontSize="12.5"
                                                                     Padding="0"
                                                                     VerticalContentAlignment="Center"/>
                                                        </Border>

                                                        <Button Grid.Column="2"
                                                                Style="{StaticResource CopyButtonStyle}"
                                                                Content="Copy"
                                                                ToolTip="Copy this value to the clipboard"
                                                                Command="{Binding CopyCommand}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
